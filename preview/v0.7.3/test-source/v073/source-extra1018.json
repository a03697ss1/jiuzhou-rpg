  "reward": "n=>{const b=R.beast(),f=floors[n-1];if(!f||n!==b.passed+1)return false;b.passed=n;S.coins+=f.coins;for(const [name,q] of [['寵物飼料',f.food],['寵物餅乾',f.biscuit],['獸魂晶',f.soul],['［特殊］自選二階妖物素材箱',f.boxes],['［特殊］萬獸徽記',f.badge]])if(q)R.give(name,q);if(f.material){if(f.grade===1){const pool=[...new Set(Object.values(JZW.dropTables).flat().map(x=>'［一階］'+x[0]))];for(let i=0;i<f.material;i++)R.give(pool[Math.floor(Math.random()*pool.length)],1,'materials');}else S.round1004.pendingRewards.push({source:'萬獸塔'+n,grade:2,count:f.material,claimed:false});}R.save();return true;}",
